NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# Absolute origin used for auth redirects (must match a Supabase "Redirect URL").
NEXT_PUBLIC_SITE_URL=

# SERVER-ONLY. Never prefix with NEXT_PUBLIC_ and never import it into a client
# component. Grants full database access and bypasses Row Level Security, so it
# must only ever be read by infrastructure/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=
